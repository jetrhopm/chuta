# Raiz del proyecto.
#
# Este archivo solo es necesario cuando el document root del servidor apunta a
# la carpeta del proyecto en lugar de apuntar a "public/" (por ejemplo XAMPP
# sirviendo http://localhost/chuta). En Hostinger la opcion preferida es
# apuntar el document root directamente a "public/", y entonces este archivo
# deja de intervenir.
#
# Nunca sustituye a la configuracion del servidor: reenvia todo a public/ y
# ademas niega el acceso directo a los archivos internos por si el reenvio se
# desactiva.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Apache resuelve estas reglas en una sola pasada y no vuelve a aplicar el
    # .htaccess de public/ despues del reenvio, asi que aqui se decide todo:
    # los recursos estaticos se mapean dentro de public/ y cualquier otra ruta
    # va directa al front controller. No se usa DirectoryIndex ni el nombre de
    # la carpeta del proyecto, para que la instalacion siga siendo portable.

    # Peticiones que ya vienen apuntando a public/ se dejan pasar.
    RewriteRule ^public/ - [L]

    # Solo se manda a public/ lo que existe ahi de verdad.
    #
    # Enrutar por extension no sirve: Livewire publica su JavaScript desde una
    # ruta de Laravel, no como archivo en disco, y una regla que capture todo
    # lo terminado en .js lo dejaria en 404 con el panel entero sin funcionar.
    # La comprobacion tampoco puede hacerse con una ruta relativa, porque
    # RewriteCond exige una ruta absoluta del sistema de archivos; por eso se
    # construye a partir de DOCUMENT_ROOT en lugar de escribir el nombre de la
    # carpeta del proyecto.

    # Todas las reglas terminan en [END] y no en [L]. Apache reevalua el
    # .htaccess despues de cada reescritura, y en esa segunda pasada
    # REQUEST_URI ya apunta a index.php: la regla de recursos estaticos
    # encontraria public/index.php en disco y desviaria ahi la peticion, con lo
    # que SCRIPT_NAME volveria a incluir "/public" y Laravel responderia 404 en
    # todas las rutas. [END] cierra el proceso y evita esa segunda pasada.

    # La aplicacion cuelga de una subcarpeta del document root
    # (por ejemplo http://localhost/chuta).
    RewriteCond %{REQUEST_URI} ^/([^/]+)/(.+)$
    RewriteCond %{DOCUMENT_ROOT}/%1/public/%2 -f
    RewriteRule ^(.+)$ public/$1 [END]

    # El document root es la raiz del proyecto.
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.+)$ public/$1 [END]

    # Todo lo demas lo resuelve Laravel a traves del front controller de la
    # raiz. No se reenvia a public/index.php a proposito: ahi SCRIPT_NAME
    # incluiria "/public" y Laravel calcularia mal la ruta base.
    RewriteRule ^ index.php [END]
</IfModule>

# Defensa en profundidad: aunque el reenvio anterior evita que estas rutas se
# resuelvan, se bloquean de forma explicita.
<FilesMatch "^(\.env.*|\.git.*|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|pint\.json|artisan|.*\.md|.*\.sqlite|.*\.log)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
